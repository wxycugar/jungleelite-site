          <li class="text-slate-400 leading-relaxed">
            Shiling Town, Huadu District,<br />Guangzhou, Guangdong, China
          </li>
          <li class="flex items-center gap-3">
            <a href="https://wa.me/8615913136225" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[#25D366] text-white hover:bg-[#20BD5A] transition-colors" aria-label="WhatsApp">
