---
const year = new Date().getFullYear();
---

<footer class="w-full bg-[#0B0F19] text-slate-400">
  <!-- Main -->
  <div class="max-w-7xl mx-auto px-6 py-16 lg:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-12">

      <!-- Brand & Vision -->
      <div class="lg:col-span-1">
        <a href="/" class="text-xl font-black text-white tracking-tight">Jungle Elite</a>
        <p class="mt-4 text-sm text-slate-400 leading-relaxed">
          Your design-driven luggage supply chain brain based in Shiling, Guangzhou. We turn ideas into global bestsellers.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-xs font-bold text-slate-500 uppercase tracking-[0.15em] mb-5">Quick Links</h4>
        <ul class="space-y-3">
          <li><a href="/" class="text-sm text-slate-400 hover:text-white transition-colors">Home</a></li>
          <li><a href="/about" class="text-sm text-slate-400 hover:text-white transition-colors">About Us</a></li>
          <li><a href="/design-cases" class="text-sm text-slate-400 hover:text-white transition-colors">Design Cases</a></li>
          <li><a href="/products" class="text-sm text-slate-400 hover:text-white transition-colors">Products</a></li>
          <li><a href="/news" class="text-sm text-slate-400 hover:text-white transition-colors">News &amp; Blogs</a></li>
          <li><a href="/contact" class="text-sm text-slate-400 hover:text-white transition-colors">Contact Us</a></li>
        </ul>
      </div>

      <!-- Core Categories -->
      <div>
        <h4 class="text-xs font-bold text-slate-500 uppercase tracking-[0.15em] mb-5">Core Categories</h4>
        <ul class="space-y-3">
          <li><a href="/category/backpack" class="text-sm text-slate-400 hover:text-white transition-colors">Backpacks</a></li>
          <li><a href="/category/softside-luggage" class="text-sm text-slate-400 hover:text-white transition-colors">Softside Luggage</a></li>
          <li><a href="/category/makeup-case" class="text-sm text-slate-400 hover:text-white transition-colors">Makeup Cases</a></li>
        </ul>
      </div>

      <!-- Direct Access -->
      <div>
        <h4 class="text-xs font-bold text-slate-500 uppercase tracking-[0.15em] mb-5">Direct Access</h4>
        <ul class="space-y-3 text-sm">
          <li><a href="mailto:info@jungleelite.com" class="text-slate-400 hover:text-white transition-colors">info@jungleelite.com</a></li>
          <li class="text-slate-400 leading-relaxed">
            Shiling Town, Huadu District,<br />Guangzhou, Guangdong, China
          </li>
          <li>
            <a href="https://wa.me/8615913136225" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-slate-400 hover:text-white transition-colors">
