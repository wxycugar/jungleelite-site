---
import Layout from '../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../utils/sanity';

interface GalleryItem {
  image: any;
  caption: string;
}

const contactData = await sanityClient.fetch(`
  *[_type == "contactPage"][0]{
    metaTitle, metaDescription,
    title, subtitle,
    hubHeroImage,
    gallery[]{
      image, caption
    },
    email, whatsapp, address, responseTime
  }
`);

const hubHeroUrl = contactData?.hubHeroImage
  ? urlFor(contactData.hubHeroImage).width(1200).format('webp').url()
  : null;
const title = contactData?.metaTitle || 'Contact Jungle Elite | Supply Chain Brain';
---

<Layout title={title}>
  <main class="w-full font-sans text-slate-800 bg-white">

    <!-- Two-Column Layout -->
    <section class="max-w-7xl mx-auto px-6 py-24 lg:py-32">
      <div class="lg:grid lg:grid-cols-2 lg:gap-16">

        <!-- Left Column: Expertise & Connection -->
        <div class="mb-16 lg:mb-0">

          <!-- Hero Image -->
          {hubHeroUrl ? (
            <div class="border-2 border-slate-200 rounded-2xl overflow-hidden mb-12">
              <img
                src={hubHeroUrl}
                alt="Jungle Elite Supply Chain Hub"
                width="1200"
                height="800"
                loading="eager"
                fetchpriority="high"
                decoding="sync"
                class="w-full h-auto object-cover"
              />
            </div>
          ) : (
            <div class="w-full aspect-[3/2] bg-slate-100 rounded-2xl border-2 border-slate-200 flex items-center justify-center text-slate-400 mb-12">
              Hub Hero
            </div>
          )}

          <!-- Page Title -->
          <h1 class="text-5xl lg:text-6xl font-black text-slate-900 leading-tight mb-4">
            {contactData?.title}
          </h1>
          <p class="text-lg text-slate-600 leading-relaxed mb-12">
            {contactData?.subtitle}
          </p>

          <!-- Contact Info Cards -->
          <div class="space-y-4 mb-16">
            <div class="flex items-center gap-5 p-5 bg-[#F8FAFC] border border-slate-100 rounded-xl">
              <div class="w-11 h-11 flex-shrink-0 rounded-lg bg-slate-900 flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Email</p>
                <a href="mailto:{contactData?.email}" class="text-slate-900 font-semibold hover:text-blue-600 transition-colors">
                  {contactData?.email}
                </a>
              </div>
            </div>

            <div class="flex items-center gap-5 p-5 bg-[#F8FAFC] border border-slate-100 rounded-xl">
              <div class="w-11 h-11 flex-shrink-0 rounded-lg bg-slate-900 flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">WhatsApp</p>
                <a href="https://wa.me/{contactData?.whatsapp?.replace(/[^0-9]/g, '')}" target="_blank" rel="noopener noreferrer" class="text-slate-900 font-semibold hover:text-blue-600 transition-colors">
                  {contactData?.whatsapp}
                </a>
              </div>
            </div>

            <div class="flex items-center gap-5 p-5 bg-[#F8FAFC] border border-slate-100 rounded-xl">
              <div class="w-11 h-11 flex-shrink-0 rounded-lg bg-slate-900 flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Address</p>
                <p class="text-slate-900 font-semibold">
                  {contactData?.address}
                </p>
              </div>
            </div>

            <div class="flex items-center gap-5 p-5 bg-[#F8FAFC] border border-slate-100 rounded-xl">
              <div class="w-11 h-11 flex-shrink-0 rounded-lg bg-slate-900 flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Response Time</p>
                <p class="text-slate-900 font-semibold">
                  {contactData?.responseTime}
                </p>
              </div>
            </div>
          </div>

          <!-- Gallery Grid -->
          {contactData?.gallery?.length > 0 && (
            <div>
              <h3 class="text-sm font-black text-slate-400 uppercase tracking-[0.2em] mb-6">
                On the Ground in Shiling
              </h3>
              <div class="grid grid-cols-2 gap-4">
                {contactData.gallery.map((item: GalleryItem) => (
                  <div class="group relative rounded-xl overflow-hidden bg-slate-100 border border-slate-200">
                    {item.image ? (
                      <img
                        src={urlFor(item.image).width(600).format('webp').url()}
                        alt={item.caption}
                        width="600"
                        height="400"
                        loading="lazy"
                        decoding="async"
                        class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-700"
                      />
                    ) : (
                      <div class="w-full h-48 flex items-center justify-center text-slate-400">Image</div>
                    )}
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-3">
                      <p class="text-white text-xs font-semibold leading-tight">{item.caption}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

        </div>

        <!-- Right Column: Design-Driven Inquiry Form -->
        <div class="lg:sticky lg:top-32 lg:self-start">
          <div class="bg-slate-900 rounded-3xl p-8 lg:p-12 shadow-2xl">
            <h2 class="text-2xl lg:text-3xl font-black text-white mb-2">
              Send Inquiry to Our Hub
            </h2>
            <p class="text-slate-400 text-sm mb-8 leading-relaxed">
              Fill out the form below and our team will respond within{' '}
              <span class="text-white font-semibold">{contactData?.responseTime || '1 hour'}</span>.
            </p>

            <form action="https://api.web3forms.com/submit" method="POST" id="inquiryForm" class="space-y-5">
              <input type="hidden" name="access_key" value="fa18cd04-1bd1-44de-a0d0-5ece1037bf24">
              <input type="checkbox" name="botcheck" class="hidden" style="display: none;">
              <div>
                <label for="name" class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Name *</label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  required
                  placeholder="Your full name"
                  class="w-full px-4 py-3.5 bg-slate-800 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all text-sm"
                />
              </div>

              <div>
                <label for="company" class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Company</label>
                <input
                  id="company"
                  name="company"
                  type="text"
                  placeholder="Your company name"
                  class="w-full px-4 py-3.5 bg-slate-800 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all text-sm"
                />
              </div>

              <div>
                <label for="email" class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Email *</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  placeholder="your@email.com"
                  class="w-full px-4 py-3.5 bg-slate-800 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all text-sm"
                />
              </div>

              <div>
                <label for="inquiry_type" class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Project Type *</label>
                <select
                  id="inquiry_type"
                  name="inquiry_type"
                  required
                  class="w-full px-4 py-3.5 bg-slate-800 border border-slate-700 rounded-xl text-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all text-sm appearance-none"
                >
                  <option value="" disabled selected>Select project type</option>
                  <option value="oem-odm">OEM / ODM</option>
                  <option value="sampling">Sampling</option>
                  <option value="stock">Stock / Wholesale</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2">Message *</label>
                <textarea
                  id="message"
                  name="message"
                  required
                  rows="5"
                  placeholder="Tell us about your project, requirements, or questions..."
                  class="w-full px-4 py-3.5 bg-slate-800 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all text-sm resize-none"
                ></textarea>
              </div>

              <button
                type="submit"
                class="w-full py-4 px-6 bg-white text-slate-900 font-black text-sm uppercase tracking-widest rounded-xl hover:bg-blue-50 transition-colors duration-300 shadow-lg"
              >
                Send Inquiry to Our Hub
              </button>

              <p class="text-xs text-slate-500 text-center leading-relaxed">
                By submitting, you agree to our{' '}
                <a href="#" class="text-slate-300 underline hover:text-white transition-colors">Privacy Policy</a>.
                We typically respond within 1 hour during business hours.
              </p>
            </form>
          </div>
        </div>

      </div>
    </section>

  </main>
</Layout>

<script>
  const form = /** @type {HTMLFormElement} */ (document.getElementById('inquiryForm'));
  const btn = /** @type {HTMLButtonElement | null} */ (form?.querySelector('button[type="submit"]'));
  const originalText = btn?.textContent ?? '';

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!btn) return;

    btn.disabled = true;
    btn.textContent = 'Sending...';
    btn.classList.add('opacity-70');

    try {
      const res = await fetch(form.action, {
        method: form.method,
        body: new FormData(form),
      });
      const data = await res.json();

      if (data.success) {
        btn.textContent = 'Sent Successfully!';
        btn.classList.remove('opacity-70');
        btn.classList.add('bg-green-500', 'text-white');
        form.reset();
        setTimeout(() => {
          btn.textContent = originalText;
          btn.disabled = false;
          btn.classList.remove('bg-green-500', 'text-white');
          btn.classList.remove('opacity-70');
        }, 4000);
      } else {
        alert('Submission failed. Please try again or email us directly.');
        btn.textContent = originalText;
        btn.disabled = false;
        btn.classList.remove('opacity-70');
      }
    } catch {
      alert('Network error. Please check your connection and try again.');
      btn.textContent = originalText;
      btn.disabled = false;
      btn.classList.remove('opacity-70');
    }
  });
</script>
