---
import Layout from '../layouts/Layout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../utils/sanity';
import { PHONE_DISPLAY, PHONE_E164, WHATSAPP_DISPLAY, WHATSAPP_URL } from '../lib/contact';

interface GalleryItem {
  image: any;
  caption: string;
}

// 注意：whatsapp 刻意不再从 CMS 读取——号码统一由 src/lib/contact.ts 提供，
// 否则站内四处各存一份，改号时极易漏改。
const contactData = await sanityClient.fetch(`
  *[_type == "contactPage"][0]{
    metaTitle, metaDescription,
    title, subtitle,
    hubHeroImage,
    gallery[]{
      image, caption
    },
    email, address, responseTime
  }
`);

const hubHeroUrl = contactData?.hubHeroImage
  ? urlFor(contactData.hubHeroImage).width(1200).format('webp').url()
  : null;
const title = contactData?.metaTitle || 'Contact Jungle Elite | Supply Chain Brain';
---

<Layout title={title}>
  <main class="w-full font-sans text-slate-800 bg-white">

    <!-- Two-Column Layout -->
    <section class="max-w-7xl mx-auto px-6 py-24 lg:py-32">
      <div class="lg:grid lg:grid-cols-2 lg:gap-16">

        <!-- Left Column: Expertise & Connection -->
        <div class="mb-16 lg:mb-0">

          <!-- Hero Image -->
          {hubHeroUrl ? (
            <div class="border-2 border-slate-200 rounded-2xl overflow-hidden mb-12">
              <img
                src={hubHeroUrl}
                alt="Jungle Elite Supply Chain Hub"
                width="1200"
                height="800"
                loading="eager"
                fetchpriority="high"
                decoding="sync"
                class="w-full h-auto object-cover"
              />
            </div>
          ) : (
            <div class="w-full aspect-[3/2] bg-slate-100 rounded-2xl border-2 border-slate-200 flex items-center justify-center text-slate-400 mb-12">
              Hub Hero
            </div>
          )}

          <!-- Page Title -->
          <h1 class="text-5xl lg:text-6xl font-black text-slate-900 leading-tight mb-4">
            {contactData?.title}
          </h1>
          <p class="text-lg text-slate-600 leading-relaxed mb-12">
            {contactData?.subtitle}
          </p>

          <!-- Contact Info Cards -->
          <div class="space-y-4 mb-16">
            <div class="flex items-center gap-5 p-5 bg-[#F8FAFC] border border-slate-100 rounded-xl">
              <div class="w-11 h-11 flex-shrink-0 rounded-lg bg-slate-900 flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Email</p>
                <a href={`mailto:${contactData?.email}`} class="text-slate-900 font-semibold hover:text-blue-600 transition-colors">
                  {contactData?.email}
                </a>
              </div>
            </div>

            <div class="flex items-center gap-5 p-5 bg-[#F8FAFC] border border-slate-100 rounded-xl">
              <div class="w-11 h-11 flex-shrink-0 rounded-lg bg-slate-900 flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Phone</p>
                <a href={`tel:${PHONE_E164}`} class="text-slate-900 font-semibold hover:text-blue-600 transition-colors">
                  {PHONE_DISPLAY}
                </a>
              </div>
            </div>

            <div class="flex items-center gap-5 p-5 bg-[#F8FAFC] border border-slate-100 rounded-xl">
              <div class="w-11 h-11 flex-shrink-0 rounded-lg bg-slate-900 flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">WhatsApp</p>
                <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="text-slate-900 font-semibold hover:text-blue-600 transition-colors">
                  {WHATSAPP_DISPLAY}
                </a>
              </div>
            </div>

            <div class="flex items-center gap-5 p-5 bg-[#F8FAFC] border border-slate-100 rounded-xl">
              <div class="w-11 h-11 flex-shrink-0 rounded-lg bg-slate-900 flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Office &amp; Showroom</p>
                <p class="text-slate-900 font-semibold">
                  {contactData?.address}
                </p>
              </div>
            </div>

            <div class="flex items-center gap-5 p-5 bg-[#F8FAFC] border border-slate-100 rounded-xl">
              <div class="w-11 h-11 flex-shrink-0 rounded-lg bg-slate-900 flex items-center justify-center">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <p class="text-xs font-bold text-slate-400 uppercase tracking-widest">Response Time</p>
                <p class="text-slate-900 font-semibold">
                  {contactData?.responseTime}
                </p>
              </div>
            </div>
          </div>

          <!--
            法定主体信息：供 Meta 企业主体真实性审核比对营业执照。
            文案必须与执照逐字一致——英文名里的 GuangZhou、地址里的 No.12 都是执照原文。
            只列执照上能逐字对得上的信息，不添加任何认证类字眼。
          -->
          <div class="mb-16 p-6 bg-[#F8FAFC] border border-slate-100 rounded-xl">
            <h2 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-5">Legal Entity</h2>
            <dl class="space-y-4">
              <div>
                <dt class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-1.5">Registered Name</dt>
                <dd class="text-slate-900 font-semibold">广州奥格商贸有限公司</dd>
                <dd class="text-slate-600">GuangZhou Organik Business Co., Ltd</dd>
              </div>
              <div>
                <dt class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-1.5">Registered Address</dt>
                <dd class="text-slate-600 leading-relaxed">广州市花都区新华街碧秀路12号（部位：3楼301室）</dd>
                <dd class="text-slate-600 leading-relaxed">ROOM 301, No.12, BIXIU ROAD, XINHUA STREET, HUADU DISTRICT, GUANGZHOU CITY</dd>
              </div>
            </dl>
          </div>

          <!-- Gallery Grid -->
          {contactData?.gallery?.length > 0 && (
            <div>
              <h3 class="text-sm font-black text-slate-400 uppercase tracking-[0.2em] mb-6">
                On the Ground in Shiling
              </h3>
              <div class="grid grid-cols-2 gap-4">
                {contactData.gallery.map((item: GalleryItem) => (
                  <div class="group relative rounded-xl overflow-hidden bg-slate-100 border border-slate-200">
                    {item.image ? (
                      <img
                        src={urlFor(item.image).width(600).format('webp').url()}
                        alt={item.caption}
                        width="600"
                        height="400"
                        loading="lazy"
                        decoding="async"
                        class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-700"
                      />
                    ) : (
                      <div class="w-full h-48 flex items-center justify-center text-slate-400">Image</div>
                    )}
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/70 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-end p-3">
                      <p class="text-white text-xs font-semibold leading-tight">{item.caption}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}

        </div>

        <!-- Right Column: Design-Driven Inquiry Form -->
        <div class="lg:sticky lg:top-32 lg:self-start">
          <div class="bg-slate-900 rounded-3xl p-8 lg:p-12 shadow-2xl">
            <InquiryForm responseTime={contactData?.responseTime || '1 hour'} />
          </div>
        </div>

      </div>
    </section>

  </main>
</Layout>
