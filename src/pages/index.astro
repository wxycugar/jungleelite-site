---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro'; // 🚀 引入我们新封装的高性能首屏组件
import { sanityClient } from 'sanity:client';

// 1. 查询首页数据
const homeData = await sanityClient.fetch(`
  *[_type == "homePage"][0]{
    metaTitle, metaDescription, geoAddress,
    heroTitle, heroSub,
    heroBeforeImage, // 修改：直接抓取图片对象，交给 Hero 组件去做 WebP 压缩
    heroAfterImage,  // 修改：直接抓取图片对象
    sec2Title,
    pillars[]{ title, subtitle, desc, "img": image.asset->url },
    bizTitle,
    customMode{ title, feature, desc },
    stockMode{ title, feature, desc },
    sec4Title, sec4Sub,
    hubTitle, hubDesc, "hubImg": hubImage.asset->url,
    hubStats[]{ _key, title, desc }, 
    sec6Title,
    steps[]{ stepNum, stepTitle, stepDesc }
  }
`);

// 2. 修复产品抓取：使用 coalesce 万能匹配图片字段
const products = await sanityClient.fetch(`
  *[_type == "product"] | order(_createdAt desc)[0...3]{
    ...,
    "imageUrl": coalesce(images[0].asset->url, image.asset->url, mainImage.asset->url)
  }
`);

// 3. SEO 标题
const title = homeData?.metaTitle || "Jungle Elite | Design-Driven Luggage Supply Chain Stationed in Shiling";
---

<Layout title={title}>
  <main class="w-full font-sans text-slate-800 bg-white">

    <HeroSection 
      title={homeData?.heroTitle} 
      subtitle={homeData?.heroSub}
      beforeImage={homeData?.heroBeforeImage}
      afterImage={homeData?.heroAfterImage}
    />

    <section class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-6">
        <h2 class="text-4xl font-bold text-center mb-16">{homeData?.sec2Title}</h2>
        <div class="grid md:grid-cols-3 gap-10">
          {homeData?.pillars?.map((item) => (
            <div class="group p-8 rounded-3xl bg-slate-50 border border-transparent hover:border-blue-100 hover:bg-white hover:shadow-2xl transition-all duration-500">
              <div class="aspect-square rounded-2xl overflow-hidden mb-8">
                <img src={item.img} alt={item.title} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" />
              </div>
              <span class="text-blue-600 font-bold tracking-widest text-sm uppercase">{item.subtitle}</span>
              <h3 class="text-2xl font-bold mt-2 mb-4 text-slate-900">{item.title}</h3>
              <p class="text-slate-500 leading-relaxed">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="py-20 bg-slate-900 text-white">
      <div class="max-w-7xl mx-auto px-6 text-center mb-16">
        <h2 class="text-4xl font-bold">{homeData?.bizTitle}</h2>
      </div>
      <div class="max-w-5xl mx-auto px-6 grid md:grid-cols-2 gap-8">
        <div class="p-10 rounded-3xl bg-slate-800 border border-slate-700">
          <div class="inline-block px-4 py-1 rounded-full bg-blue-500/20 text-blue-400 text-sm font-bold mb-6">{homeData?.customMode?.feature}</div>
          <h3 class="text-3xl font-bold mb-4">{homeData?.customMode?.title}</h3>
          <p class="text-slate-400 mb-8">{homeData?.customMode?.desc}</p>
          <a href="#contact" class="font-bold text-white border-b-2 border-blue-500 pb-1 hover:text-blue-400">Inquire Custom Project &rarr;</a>
        </div>
        <div class="p-10 rounded-3xl bg-blue-600">
          <div class="inline-block px-4 py-1 rounded-full bg-white/20 text-white text-sm font-bold mb-6">{homeData?.stockMode?.feature}</div>
          <h3 class="text-3xl font-bold mb-4">{homeData?.stockMode?.title}</h3>
          <p class="text-blue-100 mb-8">{homeData?.stockMode?.desc}</p>
          <a href="#contact" class="font-bold text-white border-b-2 border-white pb-1 hover:opacity-80">Order Stock Wholesale &rarr;</a>
        </div>
      </div>
    </section>

    <section id="products" class="py-24">
      <div class="max-w-7xl mx-auto px-6">
        <div class="mb-16">
          <h2 class="text-4xl font-bold text-slate-900 mb-4">{homeData?.sec4Title}</h2>
          <p class="text-lg text-slate-600">{homeData?.sec4Sub}</p>
        </div>
        
        <div class="grid md:grid-cols-3 gap-10">
          {products?.map((prod) => (
            <a href={`/product/${prod.slug?.current}`} class="group rounded-3xl overflow-hidden shadow-lg border border-slate-100 hover:shadow-2xl hover:border-blue-100 transition-all duration-500">
              <div class="aspect-[4/3] overflow-hidden bg-slate-50 p-3 flex items-center justify-center">
                <img 
                  src={prod.imageUrl} 
                  alt={prod.title} 
                  class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-700" 
                />
              </div>
               <div class="p-8">
                  <h3 class="text-xl font-bold text-slate-900 mb-2 truncate">{prod.title}</h3>
                  <p class="text-blue-600 text-sm font-bold tracking-widest uppercase truncate">{prod.material}</p>
               </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-6">
        <div class="bg-slate-900 rounded-[2.5rem] overflow-hidden flex flex-col lg:flex-row shadow-2xl relative">
          
          <div class="p-10 lg:p-16 lg:w-[55%] relative z-20 flex flex-col justify-center">
            <div class="inline-block px-4 py-1 rounded-full bg-blue-500/20 text-blue-400 text-xs font-bold tracking-widest uppercase mb-6 self-start">
              Stationed in Shiling
            </div>
            <h2 class="text-3xl lg:text-5xl font-black text-white leading-tight mb-6">
              {homeData?.hubTitle}
            </h2>
            <p class="text-lg text-slate-400 leading-relaxed mb-10">
              {homeData?.hubDesc}
            </p>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
              {homeData?.hubStats?.map((stat) => (
                <div class="p-5 rounded-2xl bg-slate-800/80 border border-slate-700 backdrop-blur-sm">
                  <h4 class="text-blue-500 font-black text-xl mb-2">{stat.title}</h4>
                  <p class="text-slate-400 text-xs leading-relaxed">{stat.desc}</p>
                </div>
              ))}
            </div>
          </div>

          <div class="lg:w-[45%] relative min-h-[300px] lg:min-h-full">
            <div class="absolute inset-0 bg-gradient-to-t lg:bg-gradient-to-r from-slate-900 via-slate-900/40 to-transparent z-10"></div>
            <img src={homeData?.hubImg} alt="Supply Chain Hub Brain" class="absolute inset-0 w-full h-full object-cover grayscale contrast-125 opacity-60" />
          </div>
          
        </div>
      </div>
    </section>

    <section class="py-24 bg-white border-t border-slate-100">
      <div class="max-w-7xl mx-auto px-6">
        <h2 class="text-center text-4xl font-bold mb-20">{homeData?.sec6Title}</h2>
        <div class="grid md:grid-cols-4 gap-12">
          {homeData?.steps?.map((s) => (
            <div class="relative">
              <span class="text-8xl font-black text-slate-100 absolute -top-12 -left-4 z-0">{s.stepNum}</span>
              <div class="relative z-10">
                <h3 class="text-xl font-bold mb-4 text-slate-900">{s.stepTitle}</h3>
                <p class="text-slate-500 text-sm leading-relaxed">{s.stepDesc}</p>
              </div>
            </div>
          ))}   
        </div>
      </div>
    </section>

  </main>
</Layout>