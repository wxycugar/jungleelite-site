---
import Layout from '../../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';

const products = await sanityClient.fetch(`
  *[_type == "product"] | order(_createdAt desc){
    title,
    sku,
    fabric,
    "slug": slug.current,
    "imageUrl": coalesce(mainImage.asset->url, gallery[0].asset->url)
  }
`);
---

<Layout title="All Products | Jungle Elite">
  <main class="w-full bg-slate-50/50 min-h-screen py-16 lg:py-20 font-sans text-slate-800">
    <div class="max-w-7xl mx-auto px-6">

      <nav class="text-sm text-slate-400 mb-8 font-medium tracking-wide">
        <a href="/" class="hover:text-slate-900 transition">Home</a> <span class="mx-2">/</span>
        <span class="text-slate-900">Products</span>
      </nav>

      <h1 class="text-3xl lg:text-4xl font-extrabold text-slate-900 mb-4">All Products</h1>
      <p class="text-slate-500 mb-12 text-lg">Explore our full range of luggage and bag solutions.</p>

      {products.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {products.map((prod) => (
            <a href={`/product/${prod.slug}`} class="group rounded-3xl overflow-hidden bg-white border border-slate-100 shadow-lg hover:shadow-2xl hover:border-blue-100 transition-all duration-500">
              <div class="aspect-[4/3] overflow-hidden bg-slate-50 p-6 flex items-center justify-center">
                {prod.imageUrl ? (
                  <img src={prod.imageUrl} alt={prod.title} class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-700" />
                ) : (
                  <div class="text-slate-300 italic">No Image</div>
                )}
              </div>
              <div class="p-6">
                <h3 class="text-lg font-bold text-slate-900 mb-1 truncate">{prod.title}</h3>
                <div class="flex items-center justify-between">
                  <span class="text-blue-600 text-sm font-bold tracking-widest uppercase truncate">{prod.fabric || prod.sku || ''}</span>
                  <span class="inline-flex items-center text-blue-600 text-[11px] font-bold uppercase tracking-wider bg-blue-50 border border-blue-100 rounded-full px-2.5 py-0.5">Inquire</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-24 text-slate-400">
          <p class="text-xl">No products available yet.</p>
          <p class="mt-2">Check back soon for our latest collections.</p>
        </div>
      )}

    </div>
  </main>
</Layout>