---
import Layout from '../../layouts/Layout.astro';
import { sanityClient } from 'sanity:client';
import { urlFor } from '../../utils/sanity';
import { PortableText } from 'astro-portabletext';
import PortableTextImage from '../../components/PortableTextImage.astro';

export async function getStaticPaths() {
  const posts = await sanityClient.fetch(`*[_type == "post"]{ "slug": slug.current }`);
  return posts.map((p: any) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const post = await sanityClient.fetch(
  `*[_type == "post" && slug.current == $slug][0]{
    title, metaTitle, metaDescription, excerpt, publishedAt, body, postType,
    "imageUrl": mainImage.asset->url,
    "galleryUrls": gallery[].asset->url
  }`,
  { slug }
);

if (!post) {
  return Astro.redirect('/news');
}

const metaTitle = post.metaTitle || post.title;
const components = {
  type: { image: PortableTextImage },
};

const formatDate = (d: string) =>
  new Date(d).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

<Layout title={`${metaTitle} | Jungle Elite`} description={post.metaDescription || post.excerpt}>
  <main class="w-full bg-white font-sans text-slate-800">

    <article class="max-w-3xl mx-auto px-6 py-24 lg:py-32">

      <!-- Breadcrumb -->
      <nav class="text-sm text-slate-400 mb-8 font-medium tracking-wide">
        <a href="/" class="hover:text-slate-900 transition">Home</a>
        <span class="mx-2">/</span>
        <a href="/news" class="hover:text-slate-900 transition">News</a>
        <span class="mx-2">/</span>
        <span class="text-slate-900">{post.title}</span>
      </nav>

      <!-- Badge -->
      {post.postType && (
        <span class="inline-block mb-6 px-3 py-1 text-[11px] font-bold text-slate-500 bg-slate-100 uppercase tracking-[0.15em] rounded-full">
          {post.postType === 'news' ? 'INDUSTRY NEWS' : 'COMPANY BLOG'}
        </span>
      )}

      <!-- Title -->
      <h1 class="text-4xl lg:text-5xl font-black text-slate-900 leading-tight mb-4">
        {post.title}
      </h1>

      <!-- Date -->
      {post.publishedAt && (
        <time class="text-sm text-slate-400 font-medium">
          {formatDate(post.publishedAt)}
        </time>
      )}

      <!-- Featured Image -->
      {post.imageUrl && (
        <div class="mt-10 mb-12 rounded-2xl overflow-hidden border border-slate-200">
          <img
            src={post.imageUrl}
            alt={post.title}
            width="1200"
            height="630"
            fetchpriority="high"
            decoding="sync"
            class="w-full h-auto object-cover"
          />
        </div>
      )}

      <!-- Body -->
      {post.excerpt && (
        <p class="text-lg text-slate-600 leading-relaxed mb-10 border-l-4 border-slate-300 pl-6 italic">
          {post.excerpt}
        </p>
            )}

      <!-- Body -->
      {post.body && (
        <div class="prose prose-lg prose-slate max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-a:text-blue-600 prose-img:rounded-xl">
          <PortableText value={post.body} components={components} />
        </div>
      )}
     {/* --- 👇 从这里开始替换：实拍图集画廊 (带点击放大功能) --- */}
  {post.galleryUrls && post.galleryUrls.length > 0 && (
    <div class="mt-16 border-t border-slate-200 pt-10">
      <h3 class="text-2xl font-bold text-slate-900 mb-6">
        Factory Live Evidence
      </h3>
      {/* 响应式网格 */}
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        {post.galleryUrls.map((url: string) => (
          <button 
            class="gallery-btn aspect-[4/3] overflow-hidden rounded-xl bg-slate-100 shadow-sm border border-slate-200 cursor-zoom-in relative group"
            data-img-src={url}
          >
            <img 
              src={url} 
              alt={`${post.title} - Factory Inspection`} 
              loading="lazy" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 pointer-events-none"
            />
            {/* 鼠标悬浮时显示放大图标提示 */}
            <div class="absolute inset-0 bg-black/10 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
              <svg class="w-8 h-8 text-white drop-shadow-md" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path></svg>
            </div>
          </button>
        ))}
      </div>
    </div>
  )}

  {/* 原生的全屏灯箱 (Lightbox) 弹窗 */}
  <dialog id="lightbox" class="fixed inset-0 z-50 w-full h-full max-w-full max-h-full bg-black/90 p-4 m-0 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 backdrop:bg-black/90">
    <div class="relative w-full max-w-6xl max-h-[90vh] flex items-center justify-center">
      <button id="close-lightbox" class="absolute -top-12 right-0 text-white hover:text-slate-300 text-4xl font-light cursor-pointer">&times;</button>
      <img id="lightbox-img" src="" class="max-w-full max-h-[85vh] object-contain rounded-lg shadow-2xl" />
    </div>
  </dialog>

  {/* 控制点击放大和关闭的脚本 */}
  <script>
    const buttons = document.querySelectorAll('.gallery-btn');
    const lightbox = document.getElementById('lightbox') as HTMLDialogElement;
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const closeBtn = document.getElementById('close-lightbox');

    // 点击图片打开放大镜
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-img-src');
        if (src && lightboxImg && lightbox) {
          lightboxImg.src = src;
          lightbox.showModal();
          lightbox.classList.remove('opacity-0', 'pointer-events-none');
        }
      });
    });

    // 关闭放大镜的函数
    const closeModal = () => {
      if(lightbox) {
        lightbox.classList.add('opacity-0', 'pointer-events-none');
        setTimeout(() => lightbox.close(), 300); // 等待淡出动画结束
      }
    };

    // 点击关闭按钮，或点击图片外围的黑色背景，都可以关闭
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (lightbox) lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeModal();
    });
  </script>
  {/* --- 👆 替换到这里结束 --- */}
      <!-- Footer Link -->
      <div class="mt-16 pt-8 border-t border-slate-100">
        <a
          href="/news"
          class="inline-flex items-center gap-2 text-sm font-bold text-slate-400 hover:text-slate-900 transition-colors uppercase tracking-widest"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          Back to Insights
        </a>
      </div>

    </article>
  </main>
</Layout>