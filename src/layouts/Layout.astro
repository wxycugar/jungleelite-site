---
// 1. 引入全局导航栏、页脚和样式
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

// 2. 统一支持SEO相关参数
export interface Props {
  title: string;
  description?: string;
  siteUrl?: string;
}

const { title, description = '', siteUrl = '' } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-BJ10ZBLB80"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-BJ10ZBLB80');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    
    {description && <meta name="description" content={description} />}
    {siteUrl && <link rel="canonical" href={siteUrl} />}
    
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {siteUrl && <meta property="og:url" content={siteUrl} />}
    <meta property="og:type" content="website" />
    
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}

    {/*
      流量雷达探针。import.meta.env.PROD 由 Astro 在构建期求值：本地 `astro dev`
      下整个标签根本不会出现在 HTML 里（而非靠脚本自己判断 host），所以 localhost
      连一次上报请求都发不出去。defer 保证不阻塞首屏。
    */}
    {import.meta.env.PROD && (
      <script
        is:inline
        defer
        src="https://api.orviabag.com/probe.js"
        data-site="jungleelite"
      ></script>
    )}
  </head>
  
  <body class="bg-white">
    <Navbar />

    <main><slot /></main>

    <Footer />
  </body>
</html>