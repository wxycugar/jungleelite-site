# 复制为 .env 填入真实值（.env 已在 .gitignore 中，不会入库）
# Vercel 上则在 Project → Settings → Environment Variables 配置同名变量。

# ---------- Cloudflare Turnstile ----------
# Site Key 会暴露给浏览器，官方即设计为公开值。
PUBLIC_TURNSTILE_SITE_KEY=
# Secret Key 仅服务端使用，绝不可加 PUBLIC_ 前缀。
# 属**上线必配项**：没有它服务端无从校验，而校验失败一律拒收（已移除 fail-open），
# 缺了会导致每一条询盘都被拒——接口返回 500 并提示访客直接发邮件，日志里是
# captcha-unavailable / missing-secret。
TURNSTILE_SECRET_KEY=

# ---------- 中央智能工作台网关 ----------
# 询盘经防线放行后推送至此。这是**唯一**的投递出口，没有邮件兜底：
# 未配置或推送失败时询盘不会送达，接口会返回 500 并提示访客直接发邮件。
# 因此 URL 属于上线必配项，不是可选项。
#
# 必须是**含路径的完整端点**。漏掉 /api/v1/inquiry 会被网关的路由表拒掉。
WORKSTATION_API_URL=https://api.orviabag.com/api/v1/inquiry
#
# 网关当前不校验该路由（它靠 payload 里的 site + CORS 授权），缺了也能送达，
# 因此留空不会阻断询盘，只是日志里会提示一次。留着是为了将来网关加鉴权时
# 无需回头改代码。
WORKSTATION_API_KEY=
