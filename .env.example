# 复制为 .env 填入真实值（.env 已在 .gitignore 中，不会入库）
# Vercel 上则在 Project → Settings → Environment Variables 配置同名变量。

# ---------- Cloudflare Turnstile ----------
# Site Key 会暴露给浏览器，官方即设计为公开值。
PUBLIC_TURNSTILE_SITE_KEY=
# Secret Key 仅服务端使用，绝不可加 PUBLIC_ 前缀。
TURNSTILE_SECRET_KEY=
# 运维逃生舱。默认 true（严格校验）。
# 设为 false 时，前端拿不到 token（广告拦截器屏蔽 SDK 等）也放行，仅打警告日志。
# 注意：它**不会**放宽「token 存在但被 Cloudflare 判定无效」的情况——那仍会拦截。
TURNSTILE_ENFORCE=true

# ---------- Resend 发信 ----------
RESEND_API_KEY=
# 发件人。域名必须在 Resend 后台完成验证，否则 API 会拒绝。
INQUIRY_FROM_EMAIL=Jungle Elite Inquiry <inquiry@jungleelite.com>
# 收件人，多个用英文逗号分隔。
INQUIRY_TO_EMAIL=info@jungleelite.com

# ---------- 中央智能工作台网关 ----------
# 询盘经防线放行后，先推送到这里集中沉淀；推送失败会自动降级为「只发邮件」，
# 不会阻断询盘送达。两个变量都留空时，这一步整体跳过（等价于未接入工作台）。
# 接收端点，例如 https://api.orviabag.com/ingest
WORKSTATION_API_URL=
# 网关侧签发的鉴权密钥，以 Authorization: Bearer 发送。
WORKSTATION_API_KEY=
